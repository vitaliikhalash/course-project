generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  OWNER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userProfile   UserProfile?
  cards         Card[]
  transactions  Transaction[]
  systemAuditLog SystemAuditLog[]
}


model UserProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  firstName   String?
  lastName    String?
  phoneNumber String? @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Currency {
  code     String  @id
  symbol   String
  decimals Int

  cards        Card[]
  transactions Transaction[]
}


model CardProduct {
  id              String         @id @default(cuid())
  name            String
  type            CardType
  tier            CardTier
  paymentSystem   PaymentSystem

  cards Card[]

  @@unique([type, tier, paymentSystem])
}

enum CardStatus {
  PENDING
  ACTIVE
  REJECTED
  FROZEN
}

enum CardType {
  DIGITAL
  UNIVERSAL
}

enum PaymentSystem {
  VISA
  MASTERCARD
}

enum CardTier {
  STANDARD
  GOLD
}

model Card {
  id         String   @id @default(cuid())
  userId     String
  name       String
  productId  String
  cardNumber String?  @unique
  iban       String?  @unique
  balance    Decimal  @default(0) @db.Decimal(18, 2)
  currencyCode String
  status     CardStatus @default(PENDING)

  unfreezeRequestedAt DateTime?
  createdAt  DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product  CardProduct  @relation(fields: [productId], references: [id], onUpdate: Cascade)
  currency Currency     @relation(fields: [currencyCode], references: [code], onUpdate: Cascade)
  sentTransactions     Transaction[] @relation("SentTransactions")
  receivedTransactions Transaction[] @relation("ReceivedTransactions")
}

model Transaction {
  id           String   @id @default(cuid())
  userId       String
  fromCardId   String
  toCardId     String?
  toExternal   String?
  amount       Decimal  @db.Decimal(18, 2)
  currencyCode String
  name         String
  category     String   @default("Перекази")
  status       String   @default("COMPLETED")
  time         DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromCard Card     @relation("SentTransactions", fields: [fromCardId], references: [id])
  toCard   Card?    @relation("ReceivedTransactions", fields: [toCardId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  currency Currency @relation(fields: [currencyCode], references: [code], onUpdate: Cascade)
}


model SystemAuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  userId     String?
  details    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
